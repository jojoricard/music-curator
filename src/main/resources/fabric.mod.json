{
	"schemaVersion": 1,
	"id": "musiccurator",
	"version": "${version}",
	"name": "Music Curator",
	"description": "Pick which vanilla music can play, set how often it plays, and see the current track in a small HUD.",
	"authors": [
		"RICARD Joris"
	],
	"contact": {
		"homepage": "https://github.com/jojoricard/music-curator",
		"sources": "https://github.com/jojoricard/music-curator",
		"issues": "https://github.com/jojoricard/music-curator/issues"
	},
	"license": "MIT",
	"icon": "assets/musiccurator/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.musiccurator.MusicCuratorFabric"
		],
		"modmenu": [
			"com.musiccurator.screen.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "musiccurator.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
